# 依赖与构建产物
node_modules/
.pnpm-store/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# 环境变量（.env.example 需要提交）
.env
.env.local
.env.*.local

# 日志与临时文件
*.log
tmp/
.DS_Store
Thumbs.db

# DSH 探测写权限时留下的空文件；工作区禁止删除文件，故忽略而不删
.dsh-write-probe

# 用户提供的课程材料（体积大，不入库）
课件/

# 数据库备份与一次性验证脚本（含真实数据，绝不入库）
.tmp-backup/

# 桌面打包产物（每份约 500MB，含 Electron 二进制与依赖，绝不入库）
dist-desktop/

# 由 scripts/build-api.mjs 生成的编译配置
apps/api/tsconfig.build.json
