{
  "name": "studygraph",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "db:validate": "node scripts/prisma.mjs validate --schema packages/db/prisma/schema.prisma",
    "db:format": "node scripts/prisma.mjs format --schema packages/db/prisma/schema.prisma",
    "db:generate": "node scripts/prisma.mjs generate --schema packages/db/prisma/schema.prisma",
    "db:deploy": "node scripts/prisma.mjs migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev --schema packages/db/prisma/schema.prisma",
    "db:studio": "node scripts/prisma.mjs studio --schema packages/db/prisma/schema.prisma",
    "db:ddl": "node scripts/prisma.mjs migrate diff --from-empty --to-schema-datamodel packages/db/prisma/schema.prisma --script",
    "check:drift": "node scripts/check-drift.mjs",
    "check:guards": "node scripts/check-guards-sync.mjs",
    "test:contracts": "node packages/contracts/test/ports.test.ts",
    "test:dag": "node apps/api/test/unit/dag.test.ts",
    "test:downstream": "node apps/api/test/integration/downstream-equivalence.test.ts"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "electron": "33.4.11",
    "prisma": "6.19.3"
  }
}
