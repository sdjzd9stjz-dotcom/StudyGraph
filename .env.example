# =============================================================================
# 本地开发环境变量模板。复制为 .env 后填写；.env 已被 .gitignore 忽略。
# =============================================================================

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 需要 PostgreSQL 16 + pgvector 扩展（docker-compose 里的 pgvector/pgvector:pg16）
DATABASE_URL="postgresql://studygraph:studygraph@localhost:5432/studygraph?schema=public"

# ── 队列 ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── 对象存储（S3 兼容；本地用 MinIO）────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="studygraph"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ── 服务 ──────────────────────────────────────────────────────────────────────
API_PORT="3001"
API_BASE_URL="http://localhost:3001"
WEB_PORT="3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# ── 鉴权 ──────────────────────────────────────────────────────────────────────
# 至少 32 字节随机串：openssl rand -hex 32
AUTH_SECRET="dev-only-replace-me-0000000000000000000000000000"

# ── BYOK 密钥加密（AES-256-GCM 主密钥，32 字节 base64）──────────────────────
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENCRYPTION_KEY=""

# ── LLM Gateway ───────────────────────────────────────────────────────────────
# 注意：这些 key 只被 apps/api 的 Gateway 读取，前端永远不直连厂商 API。
# 学生自带的 key 走 ProviderCredential 表（加密存储），不写在这里。
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# 契约中的两个供应商：默认模型由 Gateway 路由表决定（见 docs/architecture.md）
LLM_DEFAULT_PROVIDER="openai"

# DEEPSEEK 占位（只允许为空，不许有值）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
